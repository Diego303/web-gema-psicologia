# Sube Sharp y sus binarios nativos al node_modules raíz para que
# astro:assets pueda resolver Sharp al hacer el build con pnpm (local y en CI).
# Sin esto, pnpm deja Sharp como dependencia transitiva y Astro no la encuentra
# al optimizar las imágenes -> error "MissingSharp / Could not find Sharp".
public-hoist-pattern[]=*sharp*
public-hoist-pattern[]=@img/*
