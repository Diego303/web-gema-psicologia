---
import { site } from '../data/site';
import content from '../data/content.json';
import { url } from '../lib/url';
const c = content.inicio.hero;
---
<section class="hero">
  <!-- Loto realista animado (WebGL) servido desde public/lotus/. Va en un iframe para
       aislar su script y su CSS; dentro, el encuadre se recorta para dejar siempre
       el loto en el centro del iframe (en PC y en móvil). -->
  <iframe class="lotus-bg" src={url('lotus/index.html')} title="Flor de loto sobre el agua" aria-hidden="true" tabindex="-1"></iframe>
  <div class="wrap hero-inner"><div class="hero-text">
    <h1>{site.name} <span>{c.titleAccent}</span></h1>
    <p class="sub">{c.subtitle}</p>
  </div></div>
  <svg class="wave-bottom" viewBox="0 0 1440 90" preserveAspectRatio="none" width="100%" height="90" aria-hidden="true"><path d="M0,40 C240,80 480,80 720,52 C960,24 1200,24 1440,52 L1440,90 L0,90 Z"/></svg>
</section>

<script>
  // Coloca el loto en el hueco libre BAJO el texto, sin superponerse, sea cual sea el
  // tamaño de pantalla. El iframe empieza arriba del hero (el cielo queda detrás del
  // título) y mide «alto del hero + alto ocupado por el texto»: así su centro —donde el
  // shader dibuja el loto— cae en el centro del espacio entre el final del texto y el
  // final del hero. Lo que sobra por abajo lo recorta el overflow:hidden del hero.
  // Se recalcula al cambiar el tamaño de la ventana o del texto (p. ej. al cargar la fuente).
  const hero = document.querySelector<HTMLElement>('.hero');
  const text = hero?.querySelector<HTMLElement>('.hero-text');
  const frame = hero?.querySelector<HTMLIFrameElement>('.lotus-bg');
  if (hero && text && frame) {
    const fit = () => {
      const textBottom = text.getBoundingClientRect().bottom - hero.getBoundingClientRect().top;
      frame.style.height = `${Math.round(hero.clientHeight + textBottom)}px`;
    };
    const ro = new ResizeObserver(fit);
    ro.observe(hero);
    ro.observe(text);
  }
</script>
