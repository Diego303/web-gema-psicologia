---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import Booking from '../components/Booking.astro';
import { site } from '../data/site';
import content from '../data/content.json';
import contactoFoto from '../assets/contacto.jpg';
const c = content.contacto;
---
<Base title={c.meta.title} description={c.meta.description} current="contacto">
  <section class="contact-page"><div class="wrap"><div class="contact-info">
    <div class="cinfo reveal">
      <span class="eyebrow">{c.eyebrow}</span>
      <h1>{c.title}</h1>
      <p>{c.intro}</p>
      <div class="row"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 4h4l2 5-3 2a14 14 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg><div><b>{c.labels.telefono}</b><span>{site.phone}</span></div></div>
      <div class="row"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg><div><b>{c.labels.whatsapp}</b><span>{site.whatsapp}</span></div></div>
      <div class="row"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><div><b>{c.labels.correo}</b><span>{site.email}</span></div></div>
      <p>{c.reservaText}</p>
      <div class="reserva-row">
        <svg class="doctoralia-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 50 50" fill="none" role="img" aria-label="Reserva en Doctoralia"><path fill-rule="evenodd" clip-rule="evenodd" d="M2.98845 14.0001L18.7787 17.7256L20.1409 1.5H29.8219L31.0519 16.1736C25.4972 18.0825 22.2305 19.6074 18.4877 21.913C15.7246 23.6108 13.2118 25.5977 10.9634 27.8762L0 23.2386L2.98845 14.0001ZM35.5723 49.1948L27.7179 40.0475C28.9209 37.0919 32.3056 32.9559 35.758 30.8222L43.4018 43.4946L35.5723 49.1948ZM16.4268 49.181C22.8808 35.9916 35.2075 26.2218 49.9783 23.3065L46.9766 14.0414C29.0561 16.0691 13.8091 26.9524 5.64951 42.2353L16.4268 49.181Z" fill="#00C3A5"/></svg>
        <Booking align="start" />
      </div>
    </div>
    <Frame class="photo reveal" image={contactoFoto} alt={c.imageAlt} />
  </div></div></section>
</Base>
