---
import Base from '../layouts/Base.astro';
import WorkBlock from '../components/WorkBlock.astro';
import CtaBand from '../components/CtaBand.astro';
import Booking from '../components/Booking.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import content from '../data/content.json';
const c = content.servicios;
---
<Base title={c.meta.title} description={c.meta.description} current="servicios">
  <section class="page-head"><div class="wrap">
    <span class="eyebrow">{c.head.eyebrow}</span>
    <h1>{c.head.title} <span>{c.head.titleAccent}</span></h1>
    <p>{c.head.intro}</p>
    <Booking />
  </div></section>

  <section class="work"><div class="wrap">
    <div class="center reveal"><h2>{c.workTitle}</h2></div>

    {services.map((s) => <WorkBlock {...s} />)}
  </div></section>

  <section><div class="wrap">
    <CtaBand
      title={c.cta.title}
      text={c.cta.text}
      buttons={[{ href: site.booking.url, label: site.booking.button, class: 'btn-primary' }]}
    />
  </div></section>
</Base>
