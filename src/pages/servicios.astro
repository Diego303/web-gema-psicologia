---
import Base from '../layouts/Base.astro';
import WorkBlock from '../components/WorkBlock.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import content from '../data/content.json';
const c = content.servicios;
---
<Base title={c.meta.title} description={c.meta.description} current="servicios">
  <section class="page-head lead"><div class="wrap">
    <span class="eyebrow">{c.head.eyebrow}</span>
    <h1>{c.head.title} <span>{c.head.titleAccent}</span></h1>
    <p>{c.head.intro}</p>
    <div class="cta-row">
      <a href={site.bookingPresencial} class="btn btn-primary">{c.head.buttons.presencial}</a>
      <a href={site.bookingOnline} class="btn btn-ghost">{c.head.buttons.online}</a>
    </div>
    <div class="chips"><span class="chip"><b>{c.head.chips.presencial}</b> · {site.location}</span><span class="chip"><b>{c.head.chips.online}</b> · {site.online}</span></div>
  </div></section>

  <section class="work"><div class="wrap">
    <div class="center reveal"><h2>{c.workTitle}</h2></div>

    {services.map((s) => <WorkBlock {...s} />)}
  </div></section>

  <section><div class="wrap">
    <CtaBand
      title={c.cta.title}
      text={c.cta.text}
      buttons={[
        { href: site.bookingPresencial, label: c.cta.buttons.presencial, class: 'btn-light' },
        { href: site.bookingOnline, label: c.cta.buttons.online, class: 'btn-out' },
      ]}
    />
  </div></section>
</Base>
